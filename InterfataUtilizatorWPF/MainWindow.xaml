<Window x:Class="InterfataUtilizatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfataUtilizatorWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Adăugare Mașină" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border BorderBrush="Black" BorderThickness="1" Padding="10" CornerRadius="5" Background="#F9F9F9">
                <StackPanel>
                    <Label x:Name="lblFirma" Content="Marcă: " FontSize="14"/>
                    <TextBox x:Name="txtFirma" Margin="0,0,0,5"/>
                    <Label x:Name="lblModel" Content="Model: " FontSize="14"/>
                    <TextBox x:Name="txtModel" Margin="0,0,0,5"/>
                    <Label x:Name="lblAn" Content="An Fabricație: " FontSize="14"/>
                    <TextBox x:Name="txtAn" Margin="0,0,0,5"/>
                    <Label x:Name="lblCuloare" Content="Culoare: " FontSize="14"/>
                    <TextBox x:Name="txtCuloare" Margin="0,0,0,5"/>
                    <Label x:Name="lblOptiuni" Content="Opțiuni: " FontSize="14"/>
                    <TextBox x:Name="txtOptiuni" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="txtMesajEroare" Foreground="Red" Margin="0,10" Visibility="Collapsed"/>
            <UniformGrid Columns="2" Margin="0,10">
                <Button Content="Adaugă" Click="btnAdauga_Click" Height="30" Margin="5"/>
                <Button Content="Reset" Click="btnReset_Click" Height="30" Margin="5"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
