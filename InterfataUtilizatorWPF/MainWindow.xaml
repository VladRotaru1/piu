<Window x:Class="InterfataUtilizatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfataUtilizatorWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="800">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Mașină:" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border BorderBrush="Black" BorderThickness="1" Padding="10" CornerRadius="5" Background="#F9F9F9">
                <StackPanel>
                    <Label x:Name="lblFirma" Content="Marcă: " FontSize="14"/>
                    <TextBox x:Name="txtFirma" Margin="0,0,0,5"/>
                    <Label x:Name="lblModel" Content="Model: " FontSize="14"/>
                    <TextBox x:Name="txtModel" Margin="0,0,0,5"/>
                    <Label x:Name="lblAn" Content="An Fabricație: " FontSize="14"/>
                    <TextBox x:Name="txtAn" Margin="0,0,0,5"/>
                    <Label x:Name="lblCuloare" Content="Culoare: " FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="rbAlb"
                             Content="Alb"
                             IsChecked="True"
                             Margin="5"/>
                        <RadioButton x:Name="rbNegru"
                             Content="Negru"
                             Margin="5"/>
                        <RadioButton x:Name="rbRosu"
                             Content="Roșu"
                             Margin="5"/>
                        <RadioButton x:Name="rbAlbastru"
                             Content="Albastru"
                             Margin="5"/>
                        <RadioButton x:Name="rbGri"
                             Content="Gri"
                             Margin="5"/>
                    </StackPanel>
                    <Label x:Name="lblOptiuni" Content="Opțiuni: " FontSize="14"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="cbAerConditionat"
                              Content="Aer Condiționat"
                              Margin="5"/>
                        <CheckBox x:Name="cbNavigatie"
                              Content="Sistem Navigație"
                              Margin="5"/>
                        <CheckBox x:Name="cbCutieAutomata"
                              Content="Cutie Automată"
                              Margin="5"/>
                        <CheckBox x:Name="cbScauneIncalzite"
                              Content="Scaune Încălzite"
                              Margin="5"/>
                        <CheckBox x:Name="cbSenzoriParcare"
                              Content="Senzori Parcare"
                              Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="txtMesajEroare" Foreground="Red" Margin="0,10" Visibility="Collapsed"/>
            <UniformGrid Columns="2" Margin="0,10">
                <Button Content="Adaugă" Click="btnAdauga_Click" Height="30" Margin="5"/>
                <Button Content="Afiseaza" Click="btnAfiseaza_Click" Height="30" Margin="5"/>
                <Button Content="Modifică" Click="btnModifica_Click" Height="30" Margin="5"/>
                <Button Content="Caută" Click="btnCauta_Click" Height="30" Margin="5"/>
                <Button Content="Reset" Click="btnReset_Click" Height="30" Margin="5"/>
            </UniformGrid>
            <DataGrid x:Name="dgMasini" AutoGenerateColumns="False" Margin="0,10" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Marca" Binding="{Binding Firma}"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}"/>
                    <DataGridTextColumn Header="An Fabricație" Binding="{Binding AnFabricatie}"/>
                    <DataGridTextColumn Header="Culoare" Binding="{Binding Culoare}"/>
                    <DataGridTextColumn Header="Dotări" Binding="{Binding Optiuni}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
