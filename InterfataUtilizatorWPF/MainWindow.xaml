<Window x:Name="Targ_masini" x:Class="InterfataUtilizatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfataUtilizatorWPF"
        mc:Ignorable="d"
        Title="Târg Mașini" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="5" FontSize="13">

            <TabItem Header=" 🚗 Gestiune Mașini ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" MaxWidth="700">
                        <TextBlock Text="Mașină:" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Padding="10" CornerRadius="5" Background="#F9F9F9">
                            <StackPanel>
                                <Label x:Name="lblFirma" Content="Marcă: " FontSize="14"/>
                                <TextBox x:Name="txtFirma" Margin="0,0,0,5"/>
                                <Label x:Name="lblModel" Content="Model: " FontSize="14"/>
                                <TextBox x:Name="txtModel" Margin="0,0,0,5"/>
                                <Label x:Name="lblAn" Content="An Fabricație: " FontSize="14"/>
                                <TextBox x:Name="txtAn" Margin="0,0,0,5"/>
                                <Label x:Name="lblCuloare" Content="Culoare: " FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="rbAlb" Content="Alb" IsChecked="True" Margin="5"/>
                                    <RadioButton x:Name="rbNegru" Content="Negru" Margin="5"/>
                                    <RadioButton x:Name="rbRosu" Content="Roșu" Margin="5"/>
                                    <RadioButton x:Name="rbAlbastru" Content="Albastru" Margin="5"/>
                                    <RadioButton x:Name="rbGri" Content="Gri" Margin="5"/>
                                </StackPanel>
                                <Label x:Name="lblOptiuni" Content="Opțiuni: " FontSize="14"/>
                                <WrapPanel>
                                    <CheckBox x:Name="cbAerConditionat" Content="Aer Conditionat" Margin="5"/>
                                    <CheckBox x:Name="cbNavigatie" Content="Navigatie" Margin="5"/>
                                    <CheckBox x:Name="cbCutieAutomata" Content="Cutie Automata" Margin="5"/>
                                    <CheckBox x:Name="cbScauneIncalzite" Content="Scaune Încălzite" Margin="5"/>
                                    <CheckBox x:Name="cbSenzoriParcare" Content="Senzori Parcare" Margin="5"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="txtMesajEroare" Foreground="Red" Margin="0,5" Visibility="Collapsed"/>

                        <UniformGrid Columns="2" Margin="0,5">
                            <Button Content="Adaugă" Click="btnAdauga_Click" Height="25" Margin="2"/>
                            <Button Content="Afiseaza" Click="btnAfiseaza_Click" Height="25" Margin="2"/>
                            <Button Content="Modifică" Click="btnModifica_Click" Height="25" Margin="2"/>
                            <Button Content="Caută" Click="btnCauta_Click" Height="25" Margin="2"/>
                            <Button Content="Reset" Click="btnReset_Click" Height="25" Margin="2"/>
                        </UniformGrid>

                        <DataGrid x:Name="dgMasini" AutoGenerateColumns="False" Margin="0,5" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IDMasina}" Width="40"/>
                                <DataGridTextColumn Header="Marca" Binding="{Binding Firma}" Width="*"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="An" Binding="{Binding AnFabricatie}" Width="*"/>
                                <DataGridTextColumn Header="Culoare" Binding="{Binding Culoare}" Width="*"/>
                                <DataGridTextColumn Header="Opțiuni" Binding="{Binding Optiuni}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header=" 👤 Gestiune Clienți " Height="23" Margin="-2,-2,-2,0" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" MaxWidth="700">
                        <TextBlock Text="Client:" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Padding="10" CornerRadius="5" Background="#F2FDF2">
                            <StackPanel>
                                <Label Content="Nume: " FontSize="14"/>
                                <TextBox x:Name="txtNumeClient" Margin="0,0,0,5"/>
                                <Label Content="Prenume: " FontSize="14"/>
                                <TextBox x:Name="txtPrenumeClient" Margin="0,0,0,5"/>
                                <Label Content="Telefon: " FontSize="14"/>
                                <TextBox x:Name="txtTelefonClient" Margin="0,0,0,5"/>
                                <Label Content="Email: " FontSize="14"/>
                                <TextBox x:Name="txtEmailClient" Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,12">
                            <Button Content="Adaugă Client" Click="btnAdaugaClient_Click" Height="25" Margin="2"/>
                            <Button Content="Afișează Clienți" Click="btnAfiseazaClienti_Click" Height="25" Margin="2"/>
                            <Button Content="Modifică Client" Click="btnModificaClient_Click" Height="25" Margin="2"/>
                        </UniformGrid>

                        <DataGrid x:Name="dgClienti" AutoGenerateColumns="False" Margin="0,5" Height="180" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdClient}" Width="40"/>
                                <DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="*"/>
                                <DataGridTextColumn Header="Prenume" Binding="{Binding Prenume}" Width="*"/>
                                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header=" 🤝 Gestiune Tranzacții ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15" MaxWidth="700">
                        <TextBlock Text="Tranzacție Nouă:" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border BorderBrush="Black" BorderThickness="1" Padding="10" CornerRadius="5" Background="#F4F4FF">
                            <StackPanel>
                                <ComboBox x:Name="cbMasiniTranzactie" Height="25" Margin="5" DisplayMemberPath="DetaliiComplete"/>
                                <ComboBox x:Name="cbVanzatoriTranzactie" Height="25" Margin="5" DisplayMemberPath="NumeComplet"/>
                                <ComboBox x:Name="cbCumparatoriTranzactie" Height="25" Margin="5" DisplayMemberPath="NumeComplet"/>
                                <Label Content="Preț Tranzacție (€): " FontSize="14"/>
                                <TextBox x:Name="txtPretTranzactie" Margin="0,0,0,5"/>
                                <Label Content="Data Tranzacție: " FontSize="14"/>
                                <DatePicker x:Name="dpDataTranzactie" Margin="0,0,0,5" SelectedDate="{Binding Path=DataTranzactie, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,12">
                            <Button Content="Efectuează Tranzacție" Click="btnAdaugaTranzactie_Click" Height="25" Margin="2"/>
                            <Button Content="Istoric Tranzacții" Click="btnAfiseazaTranzactii_Click" Height="25" Margin="2"/>
                        </UniformGrid>

                        <DataGrid x:Name="dgTranzactii" AutoGenerateColumns="False" Margin="0,5" Height="180" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Tranzacție" Binding="{Binding IdTranzactie}" Width="50"/>
                                <DataGridTextColumn Header="Preț Final (€)" Binding="{Binding Pret}" Width="80"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding DataTranzactie, StringFormat=\{0:dd.MM.yyyy\}}" Width="80"/>

                                <DataGridTextColumn Header="Marcă Mașină" Binding="{Binding MasinaVanduta.Firma}" Width="*"/>
                                <DataGridTextColumn Header="Model Mașină" Binding="{Binding MasinaVanduta.Model}" Width="*"/>
                                <DataGridTextColumn Header="An Fabr." Binding="{Binding MasinaVanduta.AnFabricatie}" Width="60"/>
                                <DataGridTextColumn Header="Culoare" Binding="{Binding MasinaVanduta.Culoare}" Width="*"/>
                                <DataGridTextColumn Header="Opțiuni" Binding="{Binding MasinaVanduta.Optiuni}" Width="*"/>

                                <DataGridTextColumn Header="Nume Vânzător" Binding="{Binding Vanzator.Nume}" Width="*"/>
                                <DataGridTextColumn Header="Prenume Vânzător" Binding="{Binding Vanzator.Prenume}" Width="*"/>

                                <DataGridTextColumn Header="Nume Cumpărător" Binding="{Binding Cumparator.Nume}" Width="*"/>
                                <DataGridTextColumn Header="Prenume Cumpărător" Binding="{Binding Cumparator.Prenume}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="1" Margin="5,0,5,5" Padding="8" Background="#EAEAEA" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="{Binding NumarStatisticiText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" FontWeight="Bold" Foreground="Navy"/>
                <TextBlock Text="{Binding StatusAplicatie, UpdateSourceTrigger=PropertyChanged}" FontSize="11" FontStyle="Italic" Foreground="DarkCyan" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
    